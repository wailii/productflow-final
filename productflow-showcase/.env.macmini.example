# App runtime env file for Mac mini deployment
NODE_ENV=production
PORT=3000
ENABLE_LOCAL_AUTH=true

# In container path. docker-compose mounts host PRODUCTFLOW_DATA_DIR to /data.
LOCAL_STORAGE_ROOT=/data

# Required in production
JWT_SECRET=replace-with-random-secret
VITE_APP_ID=local-auth
OAUTH_SERVER_URL=https://example.com
VITE_OAUTH_PORTAL_URL=https://example.com

# Optional owner metadata
OWNER_OPEN_ID=
OWNER_NAME=

# Optional model defaults
BUILT_IN_FORGE_API_URL=https://api.moonshot.cn/v1
BUILT_IN_FORGE_API_KEY=placeholder
AGENT_MAX_ITERATIONS=3
AGENT_PASS_SCORE=85

# Optional external DB. Keep empty to use local persistent json fallback.
DATABASE_URL=
