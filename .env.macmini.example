# docker compose variable file (repo root)
# Copy to .env.macmini and adjust paths/token.

PRODUCTFLOW_IMAGE=productflow-showcase:macmini

# This path is on your Mac mini host and persists data across upgrades/redeploys.
PRODUCTFLOW_DATA_DIR=/Users/<your-mac-user>/server-data/productflow

# Bind only to localhost by default (no direct public exposure).
PRODUCTFLOW_BIND=127.0.0.1
PRODUCTFLOW_PORT=3000

# App env file path (relative to repo root)
APP_ENV_FILE=./productflow-showcase/.env.macmini

# Cloudflare Tunnel token.
# Leave empty if you only want LAN/local access.
CF_TUNNEL_TOKEN=
